{
  "name": "langchain-nace",
  "version": "0.1.1",
  "description": "LangChain.js integration for Drex decision models by Nace: a classifier, a router, and agent middleware for model routing and tool gating.",
  "license": "MIT",
  "author": "Nace",
  "homepage": "https://github.com/nace-ai/langchain-nace-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nace-ai/langchain-nace-js.git"
  },
  "bugs": "https://github.com/nace-ai/langchain-nace-js/issues",
  "keywords": [
    "langchain",
    "langgraph",
    "drex",
    "nace",
    "decision-model",
    "classifier",
    "agent-middleware",
    "tool-gating"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware/index.d.mts",
        "default": "./dist/middleware/index.mjs"
      },
      "require": {
        "types": "./dist/middleware/index.d.cts",
        "default": "./dist/middleware/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:int": "vitest run --mode int",
    "check:pack": "publint && attw --pack . --profile node16",
    "smoke": "node scripts/smoke-pack.mjs"
  },
  "dependencies": {
    "nace-sdk": "^0.6.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.16",
    "@langchain/langgraph": "^1.2.6",
    "langchain": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    },
    "langchain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/openai": "^1.8.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "langchain": "^1.6.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.9.0"
}
